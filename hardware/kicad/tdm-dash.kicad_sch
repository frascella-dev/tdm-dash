	)
	(text "Each block is one sheet; the wires between the blocks are the signals that cross sheets."
		(exclude_from_sim no)
		(at 19.05 153.67 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 0 0 132 1)
			)
			(justify left top)
		)
		(uuid "9f6b0d8d-b6f3-529c-868b-5b214892e207")
	)
	(text "Sheets"
		(exclude_from_sim no)
		(at 19.05 157.48 0)
		(effects
			(font
				(size 1.524 1.524)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "a9dd1998-e049-5d28-9c27-d6dbc5fed8fe")
	)
	(text "1 Power: bike connectors J101 and J102, fuse, reverse polarity, TVS, LC filter, 5 V buck, Pico hold-up\n2 Warning lights: neutral, high beam, turn signals and illumination through EL817 optocouplers\n3 Tachometer: coil negative to the H11L1 Schmitt trigger\n4 Wheel sensor: LJ12A3 inductive sensor on J401, through an EL817\n5 Analog inputs: battery voltage, coolant sender and ambient light to the ADC\n6 MCU: Raspberry Pi Pico, FRAM for the odometer, MODE and SET buttons\n7 Backlight and Pi: TPS61169 backlight driver dimmed by the Pico, USB link to the Pi\n8 Backup LEDs: indicators wired straight to the bike, alive with the electronics off"
		(exclude_from_sim no)
		(at 19.05 160.782 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "05a8aa30-ad77-57ec-a86f-a24b2a0d6c09")
	)
	(text "Net names"
		(exclude_from_sim no)
		(at 19.05 177.8 0)
		(effects
			(font
				(size 1.524 1.524)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "75da1d6a-a8ea-59c8-b8c4-6d856c4a5ebc")
	)
	(text "BIKE_…  wire from the bike harness: up to 14.5 V, with spikes\n+12V_P protected 12 V · +5V buck output · VSYS_PICO Pico supply · +3V3 Pico regulator\nSupplies are global power symbols and are not drawn on this page."
		(exclude_from_sim no)
		(at 19.05 181.102 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "27378f2b-58b0-530d-a117-937a6261f849")
	)
