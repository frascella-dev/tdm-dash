	(text "Tachometer input"
		(exclude_from_sim no)
		(at 16.51 16.51 0)
		(effects
			(font
				(size 2.54 2.54)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "8e2a7733-6bf5-5357-b49f-aea86b5f76ea")
	)
	(text "The coil negative swings by a few hundred volts at every spark.\nD301 passes the positive spikes, R301 and R302 limit the current, D302 and C301\nclamp and filter them; the H11L1 Schmitt trigger gives the Pico a clean edge."
		(exclude_from_sim no)
		(at 16.51 20.828 0)
		(effects
			(font
				(size 1.524 1.524)
				(color 0 0 132 1)
			)
			(justify left top)
		)
		(uuid "d9f2584c-fa24-50ca-bdb2-d88a736a1e53")
	)
	(text "decoupling\nof the H11L1"
		(exclude_from_sim no)
		(at 229.87 71.12 0)
		(effects
			(font
				(size 1.397 1.397)
				(color 0 0 132 1)
			)
			(justify left top)
		)
		(uuid "3312e0e9-8e36-5344-a2e8-7844fd7ed053")
	)
	(text "passes only the\npositive spikes"
		(exclude_from_sim no)
		(at 40.64 87.63 0)
		(effects
			(font
				(size 1.397 1.397)
				(color 0 0 132 1)
			)
			(justify left top)
		)
		(uuid "d74d1094-dbf2-597c-beab-c401dd59c1af")
	)
	(text "2 × 22 kΩ 1 W:\nlimit the current"
		(exclude_from_sim no)
		(at 62.23 87.63 0)
		(effects
			(font
				(size 1.397 1.397)
