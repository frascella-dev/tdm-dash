	)
	(text "Channel by channel:\nR2x2 4.7 kΩ: about 2 mA in the LED at 12 V\nD2x1: protects the LED from reverse voltage\nC2x1: filters spikes on the bike wire\nR2x1 10 kΩ: an open wire reads off\n\nThe EL817 collector pulls the GPIO low\nwhen the warning light is on."
		(exclude_from_sim no)
		(at 165.1 33.02 0)
		(effects
			(font
				(size 1.397 1.397)
				(color 0 0 132 1)
			)
			(justify left top)
		)
		(uuid "03f6fe2f-9585-503d-b3c5-cd9f32e1a813")
	)
