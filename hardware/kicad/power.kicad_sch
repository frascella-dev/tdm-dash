	(text "Bike connectors, protection and 5 V supply"
		(exclude_from_sim no)
		(at 16.51 16.51 0)
		(effects
			(font
				(size 2.54 2.54)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "aa504f91-bb4d-56a4-896a-4a7f4f72f5c0")
	)
	(text "+12V_KEY is the switched 12 V of the bike. Chain: 2 A fuse, P-MOSFET against reversed polarity,\n24 V TVS for the load dump, LC filter, 5 V buck converter for the Pi, the backlight and the Pico.\nThe Pico runs from VSYS_PICO through D103: C103 keeps it alive long enough to save the trip."
		(exclude_from_sim no)
		(at 16.51 20.828 0)
		(effects
			(font
				(size 1.524 1.524)
				(color 0 0 132 1)
			)
			(justify left top)
		)
		(uuid "ecf5737e-3fb2-5020-8c85-da8616f1059f")
	)
	(text "[TO VERIFY] pin numbers and wire colours of the\noriginal cluster connector: docs/research/original-wiring.md"
