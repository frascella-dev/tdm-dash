	)
	(text "Wired straight to the bike's 12 V lines, so they light up even with the electronics off.\nThe turn signals use the pair of wires of the original indicator: the flashing side feeds its LED,\nthe other side goes to ground through its bulbs. The 1N4148 protects each LED from the reverse 12 V."
		(exclude_from_sim no)
		(at 16.51 20.828 0)
		(effects
			(font
				(size 1.524 1.524)
				(color 0 0 132 1)
			)
			(justify left top)
		)
		(uuid "a7e95ff6-3d7d-59f2-becf-a13358f5534a")
	)
	(text "Left turn signal"
		(exclude_from_sim no)
		(at 25.4 40.64 0)
		(effects
