				(bold yes)
			)
			(justify left top)
		)
		(uuid "75ac9c65-60e2-5e41-a21c-04d5d98032d5")
	)
	(text "Current flows from the flashing side,\nthrough its LED, to the other side,\nwhich the bulbs hold near ground."
		(exclude_from_sim no)
		(at 137.16 54.61 0)
		(effects
			(font
