# SD card of the tdm-dash image. post-image.sh fills in the root filesystem
# image (EROFS for the release image, ext4 for the development one) and the
# extra boot files of the development image. The placeholders must not
# appear anywhere else in this file: sed replaces every one of them.

image boot.vfat {
	vfat {
		label = "TDMBOOT"
		files = {
			"rpi-firmware/bootcode.bin",
			"rpi-firmware/start_cd.elf",
			"rpi-firmware/fixup_cd.dat",
			"rpi-firmware/config.txt",
			"rpi-firmware/cmdline.txt",
			"rpi-firmware/overlays",
			"bcm2710-rpi-zero-2-w.dtb",
			"Image",
			"tdm-dash.toml",@EXTRA_FILES@
		}
	}

	size = 64M
}

image sdcard.img {
	hdimage {
	}

	partition boot {
		partition-type = 0xC
		bootable = "true"
		image = "boot.vfat"
	}

	partition rootfs {
		partition-type = 0x83
		image = "@ROOTFS@"
	}
}
