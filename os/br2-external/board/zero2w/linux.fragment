# tdm-dash: drivers the dashboard needs, built into the kernel because
# neither image loads modules at boot.
CONFIG_DRM=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_DRM_VC4=y
# the DPI panel (compatible "panel-dpi" in vc4-kms-dpi-generic)
CONFIG_DRM_PANEL_SIMPLE=y
CONFIG_USB_DWC2=y
CONFIG_USB_ACM=y
CONFIG_WATCHDOG=y
CONFIG_BCM2835_WDT=y
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
