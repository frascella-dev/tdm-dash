# Wi-Fi of the development image. Network name and password go in
# wpa_supplicant.conf on the boot partition (see os/README.md).
auto lo
iface lo inet loopback

auto wlan0
iface wlan0 inet dhcp
	pre-up wpa_supplicant -B -D nl80211 -i wlan0 -c /boot/wpa_supplicant.conf
	post-down killall -q wpa_supplicant
